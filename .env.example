# ---- 数据库 ----
# PostgreSQL 连接串。Prisma 7 通过 @prisma/adapter-pg 使用它
DATABASE_URL="postgresql://user:password@localhost:5432/booking?schema=public"

# ---- 认证（Auth.js v5）----
# 至少 32 字节随机串：openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---- 邮件（Resend）----
RESEND_API_KEY=""
MAIL_FROM="noreply@example.com"

# ---- 应用 ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- 监控（可留空，留空则 Sentry 不初始化）----
SENTRY_DSN=""

# 演示账号提示开关。上线前必须留空或 0，否则登录页会印出可用账号
NEXT_PUBLIC_SHOW_DEMO_HINT=""
